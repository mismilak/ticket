# کپی کنید به .env و مقادیر را تنظیم کنید
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=یک-رشته-تصادفی-بلند
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
# با HTTPS واقعی: 1 (کوکی امن + ریدایرکت)
DJANGO_HTTPS=0
# اگر Nginx/Apache پوشه media را سرو می‌کند: 0
SERVE_MEDIA=1

# دیتابیس: sqlite (پیش‌فرض) یا mysql
DB_ENGINE=sqlite
# DB_NAME=ticket
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306

# مدیر اولیه (دستور bootstrap_site)
ADMIN_MOBILE=09120000000
ADMIN_PASSWORD=admin1234
